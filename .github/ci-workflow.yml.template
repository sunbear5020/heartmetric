# GitHub Actions 워크플로 (사용 대기 템플릿)
#
# 이 파일은 .github/workflows/ci.yml 의 원본 내용입니다. 현재 GitHub 연결(Pickle GitHub App)에
# workflows 쓰기 권한이 없어 이 경로에 둘 수 없었습니다. GitHub 웹에서 이 파일을
# .github/workflows/ci.yml 로 옮기면(내용 그대로) 다음 푸시부터 CI가 자동으로 돕니다.

name: CI

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

jobs:
  test:
    name: pytest (Python ${{ matrix.python-version }})
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        python-version: ["3.10", "3.11", "3.12"]

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
          cache: pip

      - name: Install
        run: |
          python -m pip install --upgrade pip
          pip install -e ".[api,dev]"

      - name: Unit tests
        run: python -m pytest -q

      - name: CLI smoke test (synthetic demo → xlsx / json)
        run: |
          python -m heartmetric_core --demo -o /tmp/heartmetric.xlsx
          python -m heartmetric_core --demo -o /tmp/heartmetric.json
          python - <<'PY'
          import json, pathlib
          bundle = json.loads(pathlib.Path("/tmp/heartmetric.json").read_text())
          assert bundle["summary"]["available"] is True
          assert bundle["quality"]["rows_out"] > 60
          assert len(bundle["comparison"]) >= 5
          print("demo bundle ok:", bundle["summary"]["sbp"], "mmHg SBP")
          PY

      - name: API import check
        run: python -c "from api.server import app; print(app.title, len(app.routes), 'routes')"
